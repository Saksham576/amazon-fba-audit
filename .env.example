# ==============================================================================
# Amazon FBA Inventory Discrepancy & Reimbursement Audit Engine
# Environment Configuration & Zoho Mail SMTP Credentials
# ==============================================================================

# 1. Zoho Mail SMTP Configuration (NexusPulse Technologies - Forever Free Plan)
# India accounts (zoho.in) use 'smtppro.zoho.in' (or 'smtp.zoho.in').
# Global/US accounts use 'smtppro.zoho.com' (or 'smtp.zoho.com').
FBA_SMTP_HOST=smtppro.zoho.in
FBA_SMTP_PORT=465

# Authenticated Zoho mailbox username (Must match registered organization account)
FBA_SMTP_USER=team@nexuspulsetech.com

# Zoho 2FA Application-Specific Password (NOT your regular account login password!)
# To generate your App Password:
#   1. Sign in to Zoho Accounts: https://accounts.zoho.in (or https://accounts.zoho.com)
#   2. Navigate to: Security -> App Passwords
#   3. Click 'Generate New Password', name it 'FBA Audit Mailer'
#   4. Paste the 12 or 16-character generated password below:
FBA_SMTP_PASS=

# Primary From address (Must match FBA_SMTP_USER to avoid Zoho 553 Relaying disallowed error)
FBA_SENDER_EMAIL=team@nexuspulsetech.com

# Beneficiary / Owner alert recipient for revenue and contingency payouts
FBA_OWNER_EMAIL=virajtiwari52@gmail.com
